APP_ENV=production
APP_NAME=Mosala Rental Property API
API_V1_PREFIX=/api/v1

# Generate strong, unique credentials before deployment.
POSTGRES_DB=rental_property
POSTGRES_USER=mosala_rental
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+asyncpg://mosala_rental:replace-with-url-encoded-password@db:5432/rental_property

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/0

# Comma-separated HTTPS origins only. Never use '*'.
CORS_ORIGINS=https://replace-with-admin-or-web-origin.example
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
BOOKING_HOLD_SECONDS=600

# Production S3-compatible object storage. The endpoint/public URL must be
# reachable by mobile clients for presigned uploads and public listing images.
OBJECT_STORAGE_ENDPOINT=https://replace-with-storage-endpoint.example
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=mosala-rentals
OBJECT_STORAGE_ACCESS_KEY=replace-with-storage-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-storage-secret-key
OBJECT_STORAGE_PUBLIC_BASE_URL=https://replace-with-public-media-base.example
MEDIA_UPLOAD_EXPIRY_SECONDS=900
OBJECT_STORAGE_VERIFY_UPLOADS=true

MAINTENANCE_INTERVAL_SECONDS=60
MAINTENANCE_LOCK_SECONDS=300
VIEWING_REMINDER_HOURS=24
