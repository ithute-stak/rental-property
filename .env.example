APP_ENV=development
APP_NAME=Rental Property API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://rental:rental@localhost:5432/rental_property
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
BOOKING_HOLD_SECONDS=600
AUTH_SECRET_KEY=change-this-secret-before-production
ACCESS_TOKEN_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=rental-property
OBJECT_STORAGE_ACCESS_KEY=rental
OBJECT_STORAGE_SECRET_KEY=rental-development-secret
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/rental-property
MEDIA_UPLOAD_EXPIRY_SECONDS=900
OBJECT_STORAGE_VERIFY_UPLOADS=true
MAINTENANCE_INTERVAL_SECONDS=60
MAINTENANCE_LOCK_SECONDS=300
VIEWING_REMINDER_HOURS=24
