# Mosala production DNS. Point both A records at 204.12.205.224 before starting Caddy.
API_DOMAIN=api.mama.ithute.co.ls
MEDIA_DOMAIN=media.mama.ithute.co.ls
TLS_EMAIL=thekoetlisi@ithute.co.ls

# Keep the raw API listener private to the VPS. Caddy is the public HTTPS entry point.
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8090

# Release identity. Set RELEASE_SHA to the exact Git commit deployed on the VPS.
APP_VERSION=0.1.0
RELEASE_SHA=replace_with_deployed_git_commit_sha

# Web origins allowed to call the API from browsers. Mobile apps are not governed by browser CORS.
CORS_ORIGINS=https://api.mama.ithute.co.ls

# Generate URL-safe secrets, for example: openssl rand -hex 32
POSTGRES_DB=mosala_rentals
POSTGRES_USER=mosala
POSTGRES_PASSWORD=replace_with_64_hex_characters
REDIS_PASSWORD=replace_with_64_hex_characters
AUTH_SECRET_KEY=replace_with_at_least_64_hex_characters

OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=mosala-rentals
OBJECT_STORAGE_ACCESS_KEY=mosala-storage
OBJECT_STORAGE_SECRET_KEY=replace_with_a_strong_object_storage_secret
OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.mama.ithute.co.ls/mosala-rentals

# Runtime tuning
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
BOOKING_HOLD_SECONDS=600
MEDIA_UPLOAD_EXPIRY_SECONDS=900
MAINTENANCE_INTERVAL_SECONDS=60
MAINTENANCE_LOCK_SECONDS=300
VIEWING_REMINDER_HOURS=24
NOTIFICATION_RELAY_INTERVAL_SECONDS=1
NOTIFICATION_RELAY_BATCH_SIZE=100
WEBSOCKET_AUTH_TIMEOUT_SECONDS=10
WEBSOCKET_HEARTBEAT_SECONDS=20
